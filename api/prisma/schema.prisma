// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthRole {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum DocumentType {
  LOGO
  BANNER
  IMAGE
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  OTHER
}

enum CrawlType {
  HTML
  API
  GRAPHQL
  PLAYWRIGHT
  SITEMAP
  HYBRID
}

enum PaginationType {
  NONE
  PAGE_NUMBER
  OFFSET
  CURSOR
  INFINITE_SCROLL
  LOAD_MORE
  UNKNOWN
}

// Added BROKEN to support spec section 19 (Broken Scraper Detection).
enum ScraperStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
  TESTING
  BROKEN
}

// Rolled-up health rating shown on the dashboard (spec section 18).
enum ScraperHealth {
  EXCELLENT
  GOOD
  WARNING
  CRITICAL
  BROKEN
}

// Status for production scraping executions (Playwright runs against a live Scraper).
enum CrawlRunStatus {
  QUEUED
  RUNNING
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  CANCELLED
}

// Debugging depth for the diagnostics subsystem (docs/playwright-debug.md). Determined per
// Scraper, before browser context creation -- Playwright tracing cannot be enabled retroactively.
enum DiagnosticsMode {
  PRODUCTION // logs/timings/errors/metrics only, no tracing -- the default, smallest overhead
  TRACE // Playwright trace (screenshots, DOM snapshots, console, actions, timings)
  FULL_DEBUG // trace + video + HTML snapshot + network HAR -- development / hard production bugs
}

enum DiagnosticsArtifactKind {
  TRACE
  SCREENSHOT
  HTML_SNAPSHOT
  CONSOLE_LOG
  NETWORK_HAR
  VIDEO
}

// Separate from CrawlRunStatus: an AI generation/self-heal session has different
// terminal states than a production crawl (e.g. AWAITING_REVIEW has no crawl equivalent).
enum GenerationRunStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW // config produced, not yet promoted to a ScraperVersion
  SUCCESS
  FAILED
  CANCELLED
}

// Why a ScraperGenerationRun was started.
enum GenerationTrigger {
  MANUAL // user requested a scraper for a new/existing agency
  SELF_HEAL // triggered automatically after a CrawlRun failure
  SCHEDULED // periodic re-generation/health check
}

// A single computer-use action returned by the model during a generation run.
enum ComputerActionType {
  CLICK
  DOUBLE_CLICK
  TYPE
  SCROLL
  SCROLL_UP
  SCROLL_DOWN
  NAVIGATE
  GO_BACK
  CLOSE_TAB
  WAIT
  KEYPRESS
  SCREENSHOT
  DRAG
  DONE
}

enum JobStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
  STALLED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  REMOVED
  SOLD
  RENTED
  UNKNOWN
}

enum ListingType {
  SALE
  RENT
  SHORT_TERM_RENT
  UNKNOWN
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  MAISONETTE
  STUDIO
  LAND
  COMMERCIAL
  OFFICE
  WAREHOUSE
  PARKING
  OTHER
  UNKNOWN
}

enum IntegrationType {
  ESTATEWEB
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
  DEWATERMARK
}

enum AuthType {
  EMAIL_PASSWORD
  USERNAME_PASSWORD
  BEARER_TOKEN
  API_KEY
  OAUTH
}

enum CmsSyncStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// New: spec section 14 Property History -- every detectable change to a Property over time.
enum PropertyHistoryEventType {
  CREATED
  UPDATED
  PRICE_CHANGED
  IMAGE_ADDED
  IMAGE_REMOVED
  STATUS_CHANGED
  REMOVED
  REAPPEARED
}

// New: spec section 20 Notifications.
enum NotificationType {
  BROKEN_SCRAPER
  CMS_SYNC_FAILURE
  CMS_SYNC_SUCCESS
  PROPERTY_REMOVAL_SPIKE
  LARGE_CRAWL_FAILURE
  QUEUE_FAILURE
  WEBSITE_UNAVAILABLE
  ESTATEWEB_NETWORK_ERROR
  ESTATEWEB_REQUEST_TIMEOUT
  ESTATEWEB_UNAUTHORIZED
  ESTATEWEB_SESSION_EXPIRED
  ESTATEWEB_API_ERROR
  ESTATEWEB_NOT_FOUND
  ESTATEWEB_RATE_LIMITED
  ESTATEWEB_INVALID_RESPONSE
  ESTATEWEB_MISSING_PROPERTY_ID
  ESTATEWEB_VALIDATION_FAILED
  ESTATEWEB_LOGIN_FAILED
  ESTATEWEB_MISSING_CSRF
  ESTATEWEB_MISSING_SESSION_COOKIE
  ESTATEWEB_LOGIN_REDIRECT_FAILED
  ESTATEWEB_MISSING_CREDENTIALS
  ESTATEWEB_INTEGRATION_INACTIVE
  ESTATEWEB_INTEGRATION_NOT_FOUND
  ESTATEWEB_MISSING_TOKEN
  ESTATEWEB_INVALID_JSON
  ESTATEWEB_SERVER_ERROR
  ESTATEWEB_EMPTY_IMAGE
  ESTATEWEB_INVALID_PROPERTY_ID
  ESTATEWEB_LINK_NOT_FOUND
  ESTATEWEB_SESSION_PERSIST_FAILED
  AI_NORMALIZATION_FAILURE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

// Who created a ScraperVersion.
enum ScraperVersionCreatedBy {
  AI
  USER
}

// ---------------------------------------------------------------
// USERS & CMS
// ---------------------------------------------------------------

/// App users. Can track agencies and save properties.
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  phone    String? @unique
  password String

  role       AuthRole
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tracked_agencies          UserTrackedAgency[]
  saved_properties          UserProperty[]
  user_integrations         UserIntegration[]
  user_integration_settings UserIntegrationSettings[]
  integration_properties    IntegrationProperty[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

/// Destination Integration instance that normalized Property data gets synced to and ai models are integrated with.
model IntegrationTarget {
  id               String          @id @default(uuid())
  integration_type IntegrationType
  auth_type        AuthType
  base_url         String?
  allow_multiple   Boolean         @default(false)
  is_visible       Boolean         @default(true) // whether the integration is visible to the user (always visible for admin and supper admin)
  is_enabled       Boolean         @default(true) // when false, users can view but not connect or modify on the Integrations page
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  user_integrations         UserIntegration[]
  user_integration_settings UserIntegrationSettings[]

  @@map("integration_targets")
}

/// Shared configuration for a user's connection to one IntegrationTarget, independent of which
/// UserIntegration (account) is used. Exists so that integration-wide settings (e.g. EstateWeb
/// sync behavior) are edited once per (user, integration_target) instead of duplicated across
/// every connected account allowed by IntegrationTarget.allow_multiple.
model UserIntegrationSettings {
  id                    String   @id @default(uuid())
  integration_target_id String
  user_id               String
  settings              Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user                   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  integration_target     IntegrationTarget     @relation(fields: [integration_target_id], references: [id], onDelete: Cascade)
  accounts               UserIntegration[]
  integration_properties IntegrationProperty[]

  @@unique([user_id, integration_target_id])
  @@map("user_integration_settings")
}

model UserIntegration {
  id                           String   @id @default(uuid())
  integration_target_id        String
  user_id                      String
  user_integration_settings_id String
  api_key_secret               String?
  webhook_key                  String?
  email                        String?
  username                     String?
  password                     String?
  config                       Json?
  is_active                    Boolean  @default(true)
  is_default                   Boolean  @default(false)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  sync_runs           CmsSyncRun[]
  tracked_agency_link UserTrackedAgencyIntegrationLink?
  user                User                              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  integration_target  IntegrationTarget                 @relation(fields: [integration_target_id], references: [id], onDelete: Cascade)
  settings            UserIntegrationSettings           @relation(fields: [user_integration_settings_id], references: [id], onDelete: Cascade)

  @@map("user_integrations")
}

// ---------------------------------------------------------------
// SOURCE AGENCIES (scrape targets)
// ---------------------------------------------------------------

/// A target website (real-estate agency) to be scraped. Root of the whole pipeline:
/// SourceAgency -> ScraperGenerationRun (AI builds a scraper) -> Scraper -> CrawlRun (production run)
/// -> SourceProperty -> Property.
model SourceAgency {
  id                 String    @id @default(uuid())
  name               String
  base_url           String    @unique
  country            String?
  city               String?
  is_visible         Boolean   @default(false) // not displayed to the user, only to the admin
  is_enabled         Boolean   @default(false) // appears to the user for the UserTrackedAgency but cannot be activated, but not to the admin
  crawl_interval     String    @default("0 */6 * * *")
  notes              String?
  last_success_at    DateTime?
  last_failure_at    DateTime?
  last_error_message String?
  metadata           Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  scrapers                Scraper[]
  user_tracked_agencies   UserTrackedAgency[]
  scraper_generation_runs ScraperGenerationRun[]
  crawl_runs              CrawlRun[]
  source_properties       SourceProperty[]
  notifications           Notification[]

  @@index([is_visible])
  @@index([is_enabled])
  @@map("source_agencies")
}

/// Which SourceAgencies a user follows/monitors, and which kinds of change notify them.
model UserTrackedAgency {
  id                         String   @id @default(uuid())
  user_id                    String
  source_agency_id           String
  enabled                    Boolean  @default(true)
  concurrent_insertions      Int      @default(1) // the number of properties to insert concurrently to the EstateWeb integration
  insertion_interval_minutes Int      @default(5) // the interval between concurrent insertions to the EstateWeb integration
  max_properties             Int? // max listings allowed in the linked CRM; null = unlimited
  text_truncate_pieces       String[] @default([])
  track_new_listings         Boolean  @default(true)
  track_removed_listings     Boolean  @default(true)
  track_updated_listings     Boolean  @default(true)
  auto_update_to_crm         Boolean  @default(true) // when false, CRM updates are pushed manually from Properties
  use_ai_batching            Boolean  @default(false)
  remove_watermark           Boolean  @default(false)
  watermark_image_count      Int      @default(10)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  user             User                              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_agency    SourceAgency                      @relation(fields: [source_agency_id], references: [id], onDelete: Cascade)
  crawl_runs       CrawlRun[]
  integration_link UserTrackedAgencyIntegrationLink?

  @@unique([user_id, source_agency_id])
  @@index([user_id])
  @@index([source_agency_id])
  @@map("user_tracked_agencies")
}

model UserTrackedAgencyIntegrationLink {
  id                     String   @id @default(uuid())
  user_tracked_agency_id String   @unique
  user_integration_id    String   @unique
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user_tracked_agency UserTrackedAgency @relation(fields: [user_tracked_agency_id], references: [id], onDelete: Cascade)
  user_integration    UserIntegration   @relation(fields: [user_integration_id], references: [id], onDelete: Cascade)

  @@map("user_tracked_agency_integration_links")
}

// ---------------------------------------------------------------
// AI GENERATION LAYER (computer-use loop)
// ---------------------------------------------------------------

/// A scraper definition for one agency. Holds NO config directly -- config always lives on the
/// active ScraperVersion (see `active_version`). This keeps a single source of truth instead of
/// letting Scraper.config and ScraperVersion.config drift out of sync.
model Scraper {
  id                   String          @id @default(uuid())
  source_agency_id     String
  name                 String
  active_version_id    String?         @unique // FK to the ScraperVersion currently in use
  version_count        Int             @default(0) // convenience counter, incremented on new versions
  status               ScraperStatus   @default(TESTING)
  self_healing_enabled Boolean         @default(true) // whether self-heal is allowed to auto-apply fixes
  diagnostics_mode     DiagnosticsMode @default(PRODUCTION) // debugging depth for this scraper's crawl runs
  health               ScraperHealth   @default(GOOD) // cached rollup, recomputed by a background job (spec section 18)
  success_rate         Decimal?        @db.Decimal(5, 2) // cached % over trailing window
  avg_runtime_ms       Int? // cached average CrawlRun duration
  consecutive_failures Int             @default(0) // reset to 0 on any SUCCESS CrawlRun
  normalize_limit      Int? // max SourceProperties to AI-normalize per crawl; null = unlimited
  last_success_at      DateTime?
  last_failure_at      DateTime?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  source_agency  SourceAgency    @relation(fields: [source_agency_id], references: [id], onDelete: Cascade)
  active_version ScraperVersion? @relation("ActiveVersion", fields: [active_version_id], references: [id], onDelete: SetNull)

  crawl_runs              CrawlRun[]
  versions                ScraperVersion[]        @relation("ScraperVersions")
  execution_traces        ScraperExecutionTrace[]
  scraper_generation_runs ScraperGenerationRun[]
  notifications           Notification[]
  diagnostics_packages    DiagnosticsPackage[]

  @@index([source_agency_id])
  @@index([status])
  @@index([health])
  @@map("scrapers")
}

/// One AI (or human) session that produces or fixes a scraper config. This is the row that
/// owns a computer-use loop: it's created, the loop runs (see ComputerUseStep), and it ends
/// with either a promoted ScraperVersion or a failure.
model ScraperGenerationRun {
  id                  String              @id @default(uuid())
  source_agency_id    String
  scraper_id          String? // set when this run is fixing/updating an existing Scraper (self-heal or manual re-gen)
  trigger             GenerationTrigger   @default(MANUAL)
  status              GenerationRunStatus @default(QUEUED)
  prompt              String? // goal/instructions given to the model
  staged_config       Json? // draft config produced by the model, pending review/promotion
  produced_version_id String?             @unique // set once staged_config is approved and copied into a ScraperVersion
  error_message       String?
  started_at          DateTime?
  finished_at         DateTime?
  duration_ms         Int?
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt

  source_agency    SourceAgency    @relation(fields: [source_agency_id], references: [id], onDelete: Cascade)
  scraper          Scraper?        @relation(fields: [scraper_id], references: [id], onDelete: SetNull)
  produced_version ScraperVersion? @relation("ProducedVersion", fields: [produced_version_id], references: [id], onDelete: SetNull)

  steps ComputerUseStep[]

  @@index([source_agency_id])
  @@index([scraper_id])
  @@index([status])
  @@map("scraper_generation_runs")
}

/// A single action in the computer-use loop: model receives a screenshot, returns an action
/// (click/type/scroll/...), Playwright executes it, a new screenshot is captured. Storing every
/// step lets you replay a session, debug why the AI navigated somewhere wrong, and show the
/// user an audit trail of how a scraper config was derived.
model ComputerUseStep {
  id                        String             @id @default(uuid())
  scraper_generation_run_id String
  step_index                Int // ordering within the run, starting at 0
  action_type               ComputerActionType
  action_payload            Json // raw action from the model, e.g. {"x":320,"y":540} or {"text":"..."}
  screenshot_before_id      String?
  screenshot_after_id       String?
  model_reasoning           String? // optional chain-of-thought / rationale text returned by the model
  created_at                DateTime           @default(now())

  scraper_generation_run ScraperGenerationRun @relation(fields: [scraper_generation_run_id], references: [id], onDelete: Cascade)
  screenshot_before      Document?            @relation("ComputerUseStepScreenshotBefore", fields: [screenshot_before_id], references: [id], onDelete: SetNull)
  screenshot_after       Document?            @relation("ComputerUseStepScreenshotAfter", fields: [screenshot_after_id], references: [id], onDelete: SetNull)

  @@index([scraper_generation_run_id])
  @@index([scraper_generation_run_id, step_index])
  @@index([screenshot_before_id])
  @@index([screenshot_after_id])
  @@map("computer_use_steps")
}

/// Immutable, versioned scraper config. This is the single source of truth for "what a scraper
/// does" -- Scraper.active_version_id points here. New versions are created by generation runs
/// (AI) or manual edits (human review), enabling rollback and full history / self-healing.
model ScraperVersion {
  id         String                  @id @default(uuid())
  scraper_id String
  version    Int
  config     Json // full scraper definition: start_url, listing_selector, fields, pagination, etc.
  created_by ScraperVersionCreatedBy
  notes      String? // e.g. reason for the fix, summary of what changed from prior version
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt

  scraper Scraper @relation("ScraperVersions", fields: [scraper_id], references: [id], onDelete: Cascade)

  // Back-relations used only to let other models point at "the" active/produced version.
  active_for_scraper Scraper?              @relation("ActiveVersion")
  produced_by_run    ScraperGenerationRun? @relation("ProducedVersion")

  @@unique([scraper_id, version])
  @@map("scraper_versions")
}

/// Step-by-step log of a PRODUCTION Playwright execution (not the AI's exploratory computer-use
/// loop -- see ComputerUseStep for that). Used to detect broken selectors / navigation failures
/// and feed them into a self-heal ScraperGenerationRun.
model ScraperExecutionTrace {
  id            String   @id @default(uuid())
  scraper_id    String
  crawl_run_id  String?
  steps         Json // Playwright step-by-step execution log
  success       Boolean
  error_summary String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  scraper   Scraper   @relation(fields: [scraper_id], references: [id], onDelete: Cascade)
  crawl_run CrawlRun? @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([scraper_id])
  @@map("scraper_execution_traces")
}

// ---------------------------------------------------------------
// PRODUCTION EXECUTION LAYER
// ---------------------------------------------------------------

/// One production scraping execution of a Scraper against its SourceAgency. This is the
/// Playwright run that uses the config from Scraper.active_version -- no AI involved in the
/// crawl itself, unless normalization (Feature 06) or a failure triggers self-heal.
model CrawlRun {
  id                           String         @id @default(uuid())
  source_agency_id             String
  scraper_id                   String?
  user_tracked_agency_id       String?
  status                       CrawlRunStatus @default(QUEUED)
  started_at                   DateTime?
  finished_at                  DateTime?
  duration_ms                  Int?
  total_found                  Int            @default(0) // all items seen in this scrape (dedup'd within the run)
  total_new_listings           Int            @default(0) // of total_found, how many were brand-new SourceProperty rows
  total_refreshed_listings     Int            @default(0) // of total_found, how many were already-known SourceProperty rows re-seen
  // total_created/updated/removed/linked/failed below are rolled up from cms_sync_runs (sum across
  // every user's CmsSyncRun for this run) -- NOT the raw scrape diff above. Stays 0 until the
  // EstateWeb sync writes results. See CrawlRunsService.recalculateCmsSyncTotals.
  total_created                Int            @default(0)
  total_updated                Int            @default(0)
  total_removed                Int            @default(0)
  total_linked                 Int            @default(0)
  total_failed                 Int            @default(0)
  error_message                String?
  metadata                     Json?
  ai_model                     String?
  ai_input_tokens              Int?
  ai_output_tokens             Int?
  ai_input_cost                Decimal?       @db.Decimal(12, 6)
  ai_output_cost               Decimal?       @db.Decimal(12, 6)
  ai_total_cost                Decimal?       @db.Decimal(12, 6)
  ai_average_cost_per_property Decimal?       @db.Decimal(12, 8)
  created_at                   DateTime       @default(now())
  updated_at                   DateTime       @updatedAt

  source_agency       SourceAgency            @relation(fields: [source_agency_id], references: [id], onDelete: Cascade)
  user_tracked_agency UserTrackedAgency?      @relation(fields: [user_tracked_agency_id], references: [id], onDelete: SetNull)
  scraper             Scraper?                @relation(fields: [scraper_id], references: [id], onDelete: SetNull)
  job_logs            JobLog[]
  execution_traces    ScraperExecutionTrace[]
  property_history    PropertyHistory[]
  notifications       Notification[]
  diagnostics_package DiagnosticsPackage?
  cms_sync_runs       CmsSyncRun[]

  @@index([source_agency_id])
  @@index([scraper_id])
  @@index([status])
  @@index([created_at])
  @@map("crawl_runs")
}

/// Failure diagnostics package for a crawl run's main listing scrape. Only created when the run
/// fails AND Scraper.diagnostics_mode is TRACE/FULL_DEBUG -- successful runs discard whatever was
/// collected without persisting anything (see DiagnosticsCaptureService).
model DiagnosticsPackage {
  id                 String          @id @default(uuid())
  crawl_run_id       String          @unique
  scraper_id         String
  mode               DiagnosticsMode
  url                String
  worker_id          String?
  browser_version    String?
  playwright_version String?
  scraper_version    Int?
  retry_number       Int?
  started_at         DateTime
  finished_at        DateTime
  duration_ms        Int
  failure_reason     String?
  exception          String?
  created_at         DateTime        @default(now())

  crawl_run CrawlRun              @relation(fields: [crawl_run_id], references: [id], onDelete: Cascade)
  scraper   Scraper               @relation(fields: [scraper_id], references: [id], onDelete: Cascade)
  artifacts DiagnosticsArtifact[]

  @@index([scraper_id])
  @@map("diagnostics_packages")
}

/// One stored blob (trace/screenshot/HTML/console/HAR/video) belonging to a DiagnosticsPackage,
/// uploaded to GCS. Only `path` (the GCS object path) is persisted -- URLs are signed on demand
/// at read time (see DiagnosticsService.findOne) since the bucket is private and a stored URL
/// would go stale.
model DiagnosticsArtifact {
  id                     String                  @id @default(uuid())
  diagnostics_package_id String
  kind                   DiagnosticsArtifactKind
  path                   String
  content_type           String
  size_bytes             Int
  created_at             DateTime                @default(now())

  diagnostics_package DiagnosticsPackage @relation(fields: [diagnostics_package_id], references: [id], onDelete: Cascade)

  @@index([diagnostics_package_id])
  @@map("diagnostics_artifacts")
}

/// Generic queue/job execution log (e.g. BullMQ), optionally tied to a CrawlRun. Useful for
/// ops/debugging independent of the scraping domain model.
model JobLog {
  id            String    @id @default(uuid())
  queue_name    String
  job_id        String?
  job_name      String?
  status        JobStatus
  attempt       Int       @default(0)
  max_attempts  Int?
  crawl_run_id  String?
  payload       Json?
  result        Json?
  error_message String?
  stack_trace   String?
  started_at    DateTime?
  finished_at   DateTime?
  duration_ms   Int?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  crawl_run CrawlRun? @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([queue_name])
  @@index([job_id])
  @@index([status])
  @@index([crawl_run_id])
  @@index([created_at])
  @@map("job_logs")
}

// New: dashboard section 20 -- persisted notifications, independent of any push/email channel.
model Notification {
  id               String               @id @default(uuid())
  type             NotificationType
  severity         NotificationSeverity @default(INFO)
  title            String
  message          String
  source_agency_id String?
  scraper_id       String?
  crawl_run_id     String?
  is_read          Boolean              @default(false)
  created_at       DateTime             @default(now())

  source_agency SourceAgency? @relation(fields: [source_agency_id], references: [id], onDelete: SetNull)
  scraper       Scraper?      @relation(fields: [scraper_id], references: [id], onDelete: SetNull)
  crawl_run     CrawlRun?     @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([severity])
  @@index([is_read])
  @@index([created_at])
  @@map("notifications")
}

// New: spec section 15 -- one batch push of affected properties to a single
// UserIntegration (e.g. one EstateWeb account). NOT one row per property: total_created/
// total_updated/total_removed/total_linked/total_failed hold the outcome breakdown for the whole batch.
// total_linked = reconciled to an existing CMS listing without a push (skipped_push).
// crawl_run_id is set only when the batch was triggered by an actual scrape (CrawlRun.total_*
// is then the sum of these across every user_integration for that run, see
// CrawlRunsService.recalculateCmsSyncTotals); it is null for backfill/manual pushes that
// aren't tied to a crawl. Retries update this same row in place (attempt/status/error_message/
// response) rather than creating a new row per attempt.
model CmsSyncRun {
  id                  String        @id @default(uuid())
  crawl_run_id        String?
  user_integration_id String
  status              CmsSyncStatus @default(PENDING)
  attempt             Int           @default(0)
  max_attempts        Int?
  total_created       Int           @default(0)
  total_updated       Int           @default(0)
  total_removed       Int           @default(0)
  total_linked        Int           @default(0)
  total_failed        Int           @default(0)
  payload             Json?
  response            Json?
  error_message       String?
  started_at          DateTime?
  finished_at         DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  crawl_run        CrawlRun?       @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)
  user_integration UserIntegration @relation(fields: [user_integration_id], references: [id], onDelete: Cascade)

  @@unique([crawl_run_id, user_integration_id])
  @@index([user_integration_id])
  @@index([status])
  @@index([created_at])
  @@map("cms_sync_runs")
}

// ---------------------------------------------------------------
// OUTPUT LAYER
// ---------------------------------------------------------------

/// Raw listing as extracted from a single source website. Not yet normalized/deduplicated --
/// that happens in Property. One SourceProperty per (agency, url).
model SourceProperty {
  id                String         @id @default(uuid())
  source_agency_id  String
  property_id       String // the property id from the agency url
  internal_id       String? // the property public id from property description
  source_url        String
  canonical_url     String?
  raw_title         String?
  raw_description   String?
  raw_price         String?
  raw_location      String?
  raw_property_type String?
  raw_listing_type  String?
  raw_sqm           String?
  raw_bedrooms      String?
  raw_bathrooms     String?
  raw_data          Json?
  raw_html_path     String? // GCS object path for the detail-page HTML snapshot
  content_hash      String? // used for deduplication
  first_seen_at     DateTime       @default(now())
  last_seen_at      DateTime?
  status            PropertyStatus @default(ACTIVE)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  source_agency  SourceAgency         @relation(fields: [source_agency_id], references: [id], onDelete: Cascade)
  property_links PropertySourceLink[]

  @@unique([source_agency_id, source_url])
  @@index([source_agency_id])
  @@index([property_id])
  @@index([internal_id])
  @@index([content_hash])
  @@index([status])
  @@index([last_seen_at])
  @@map("source_properties")
}

/// Normalized, deduplicated property record -- the canonical entity synced to the CMS.
/// May be backed by multiple SourceProperty rows (same listing found on multiple agencies).
model Property {
  id                    String         @id @default(uuid())
  title                 String
  description           String?
  property_id           String // the property id from the agency url
  internal_id           String? // the property public id from property description
  listing_type          ListingType    @default(UNKNOWN)
  property_type         PropertyType   @default(UNKNOWN)
  status                PropertyStatus @default(ACTIVE)
  price                 Decimal?       @db.Decimal(14, 2)
  currency              String?        @default("EUR")
  city                  String?
  district              String?
  address               String?
  postal_code           String?
  country               String?
  latitude              Decimal?       @db.Decimal(10, 7)
  longitude             Decimal?       @db.Decimal(10, 7)
  square_meters         Decimal?       @db.Decimal(10, 2)
  bedrooms              Int?
  bathrooms             Int?
  floor                 String?
  construction_year     Int?
  renovation_year       Int?
  features              Json?
  images                Json?
  normalized_data       Json?
  estateweb_type_id     Int?
  estateweb_location_id Int?
  estateweb_scope_id    Int?
  cms_fields            Json?
  cms_metadata          Json?
  video_url             String?
  distance_airport      String?
  distance_port         String?
  distance_beach        String?
  price_start           Decimal?       @db.Decimal(14, 2)
  price_web             Decimal?       @db.Decimal(14, 2)
  duplicate_group_id    String?
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  source_links           PropertySourceLink[]
  user_property_copies   UserProperty[]
  history                PropertyHistory[] // spec section 14

  @@index([listing_type])
  @@index([property_type])
  @@index([status])
  @@index([city])
  @@index([district])
  @@index([price])
  @@index([duplicate_group_id])
  @@index([property_id])
  @@index([internal_id])
  @@map("properties")
}


/// Mapping layer between normalized Property and the raw SourceProperty rows it was built from.
model PropertySourceLink {
  id                   String   @id @default(uuid())
  property_id          String
  source_property_id   String
  confidence_score     Decimal? @db.Decimal(5, 2)
  is_primary_source    Boolean  @default(false)
  last_normalized_hash String? // SourceProperty.content_hash as of the last AI normalization; lets us skip re-normalizing unchanged listings
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  property        Property       @relation(fields: [property_id], references: [id], onDelete: Cascade)
  source_property SourceProperty @relation(fields: [source_property_id], references: [id], onDelete: Cascade)

  @@unique([property_id, source_property_id])
  @@index([property_id])
  @@index([source_property_id])
  @@map("property_source_links")
}

// New: spec section 14 Property History -- append-only audit log of everything that happened to a
// Property. This is what powers "Price Changes", "Images Added/Removed", "Removal",
// "Reappearance" etc. in the property detail view. Never mutated, only appended to.
model PropertyHistory {
  id           String                   @id @default(uuid())
  property_id  String
  event_type   PropertyHistoryEventType
  field        String? // e.g. "price", "images", "status" -- null for CREATED/REMOVED/REAPPEARED
  old_value    Json?
  new_value    Json?
  crawl_run_id String? // which crawl detected this change, if any
  created_at   DateTime                 @default(now())

  property  Property  @relation(fields: [property_id], references: [id], onDelete: Cascade)
  crawl_run CrawlRun? @relation(fields: [crawl_run_id], references: [id], onDelete: SetNull)

  @@index([property_id])
  @@index([event_type])
  @@index([crawl_run_id])
  @@map("property_history")
}

/// User-owned, editable copy of a canonical Property. Created automatically the first time a
/// tracked agency's scraper surfaces a matching Property; after that, edits apply ONLY to this
/// row -- the canonical Property keeps being updated by the crawler independently.
/// `is_modified` / `last_synced_at` track whether (and when) this copy has diverged, so the UI
/// can show a "this differs from the source listing" banner and offer a manual re-sync.
model UserProperty {
  id                      String         @id @default(uuid())
  user_id                 String
  canonical_property_id   String
  property_id             String
  internal_id             String?
  integration_property_id String?
  title                   String
  description             String?
  listing_type            ListingType    @default(UNKNOWN)
  property_type           PropertyType   @default(UNKNOWN)
  status                  PropertyStatus @default(ACTIVE)
  price                   Decimal?       @db.Decimal(14, 2)
  currency                String?        @default("EUR")
  city                    String?
  district                String?
  address                 String?
  postal_code             String?
  country                 String?
  latitude                Decimal?       @db.Decimal(10, 7)
  longitude               Decimal?       @db.Decimal(10, 7)
  square_meters           Decimal?       @db.Decimal(10, 2)
  bedrooms                Int?
  bathrooms               Int?
  floor                   String?
  construction_year       Int?
  renovation_year         Int?
  features                Json?
  images                  Json?
  normalized_data         Json?
  estateweb_type_id       Int?
  estateweb_location_id   Int?
  estateweb_scope_id      Int?
  cms_fields              Json?
  cms_metadata            Json?
  video_url               String?
  distance_airport        String?
  distance_port           String?
  distance_beach          String?
  price_start             Decimal?       @db.Decimal(14, 2)
  price_web               Decimal?       @db.Decimal(14, 2)
  duplicate_group_id      String?
  is_modified             Boolean        @default(false)
  pending_crm_update      Boolean        @default(false)
  last_synced_at          DateTime? // last time this copy was refreshed from canonical_property
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt

  user                   User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  canonical_property     Property              @relation(fields: [canonical_property_id], references: [id], onDelete: Cascade)
  integration_properties IntegrationProperty[]

  @@unique([user_id, canonical_property_id])
  @@index([user_id])
  @@index([canonical_property_id])
  @@index([property_id])
  @@map("user_properties")
}

model IntegrationProperty {
  id                           String   @id @default(uuid())
  user_id                      String
  user_integration_settings_id String
  user_property_id             String
  images                       Json?
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt

  user                      User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_integration_settings UserIntegrationSettings @relation(fields: [user_integration_settings_id], references: [id], onDelete: Cascade)
  user_property             UserProperty            @relation(fields: [user_property_id], references: [id], onDelete: Cascade)

  @@unique([user_id, user_integration_settings_id, user_property_id], map: "integration_properties_user_settings_user_property_key")
  @@index([user_id])
  @@index([user_property_id])
  @@index([user_integration_settings_id])
  @@map("integration_properties")
}

/// Singleton table (single row, fixed id) holding tunable admin-editable parameters for the
/// whole app, grouped by subsystem prefix (crawler_*, and more subsystems over time). Columns
/// are nullable -- PlatformConfigService resolves nulls to in-code defaults per subsystem, so
/// this table is never a hard requirement for anything to run.
model PlatformConfig {
  id                                           String   @id @default("singleton")
  crawler_max_pages                            Int?
  crawler_page_timeout_ms                      Int?
  crawler_selector_timeout_ms                  Int?
  crawler_scroll_pause_ms                      Int?
  crawler_detail_concurrency                   Int?
  crawler_detail_delay_ms                      Int?
  crawler_worker_concurrency                   Int?
  crawler_job_timeout_ms                       Int?
  crawler_chromium_max_contexts_before_restart Int?
  normalization_ai_raw_description_max_chars   Int?
  created_at                                   DateTime @default(now())
  updated_at                                   DateTime @updatedAt

  @@map("platform_config")
}

/// Generic uploaded file record (logos, banners, media, and computer-use screenshots).
model Document {
  id         String       @id @default(uuid())
  user_uuid  String
  filename   String
  mimetype   String
  size       Int
  url        String
  path       String
  type       DocumentType @default(LOGO)
  created_at DateTime     @default(now())

  computer_use_steps_before ComputerUseStep[] @relation("ComputerUseStepScreenshotBefore")
  computer_use_steps_after  ComputerUseStep[] @relation("ComputerUseStepScreenshotAfter")

  @@index([user_uuid])
  @@map("documents")
}
